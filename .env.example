# Runtime environment mode: development | test | production
NODE_ENV="development"

# Set to "true" in self-hosted production to require explicit secrets, APP_URL, OTP_PROVIDER, and S3_* on startup
STRICT_ENV="false"

# HTTP server listening port (default 3000)
PORT="3000"

# Canonical public base URL of this application (used for cookies, CSRF origin, and media URLs)
APP_URL="http://localhost:3000"

# Neon / PostgreSQL connection string (sslmode=require supported with verified TLS)
DATABASE_URL=""

# Optional custom PEM CA certificate for PostgreSQL TLS verification (do not disable verification)
DATABASE_CA_CERT=""

# Session signing secret (minimum 32 UTF-8 bytes; required in production)
SESSION_SECRET=""

# 32-byte base64 key for AES-256-GCM encryption of user phone numbers (required in production)
PHONE_ENC_KEY=""

# Secret key for HMAC-SHA256 phone lookup index (minimum 16 chars; required in production)
PHONE_HMAC_KEY=""

# Secret pepper for HMAC-SHA256 OTP challenge hashing (minimum 16 chars; required in production)
OTP_PEPPER=""

# OTP delivery provider: console (dev fallback) | generic-http (production SMS gateway webhook)
OTP_PROVIDER="console"

# Generic HTTP OTP webhook endpoint and bearer token (required when OTP_PROVIDER=generic-http)
OTP_HTTP_URL=""
OTP_HTTP_TOKEN=""

# S3-compatible object storage (Cloudflare R2 / AWS S3 / MinIO); falls back to ./.data/uploads in development
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_BASE_URL=""

# Optional comma-separated list of extra CORS origins (default: same-origin only)
ALLOWED_ORIGINS=""

# Express trust proxy setting (false | true | hop count integer like 1)
TRUST_PROXY="false"

# Optional backend origin for Capacitor Android/mobile builds (leave empty for same-origin web)
VITE_API_BASE_URL=""

