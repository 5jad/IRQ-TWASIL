{
	"appId": "iq.tawasul.app",
	"appName": "IRQ تواصل",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#FAF9F7",
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"SystemBars": {
			"insetsHandling": "css",
			"initialViewportFitValueHint": "cover",
			"style": "DEFAULT"
		},
		"StatusBar": {
			"overlaysWebView": true
		}
	}
}
